#!/usr/bin/env bash
# zs — Zellij session manager

SCRIPT=$(realpath "$0")
ZS_GHOSTTY_ENV=(env GHOSTTY_AUTO_ZELLIJ=0 ZS_SUPPRESS_AUTO_ZELLIJ=1)
ZS_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zs"
ZS_EXITED_FILE="$ZS_STATE_DIR/exited-sessions"
ZS_NOTICE_FILE="$ZS_STATE_DIR/notice"
ZS_NEW_SESSION_LABEL=$'\033[1;7;94m✚ Add New Session\033[0m'
ZS_NEW_SESSION_LABEL_CLEAN='✚ Add New Session'
HEADER=$'a attach   k kill   d delete\nf force    r rename / search'
DELETE_HINT='d only deletes exited sessions; press k first'

_name() {
    local clean
    clean=$(printf '%s' "$1" | sed 's/\x1b\[[0-9;]*m//g')
    [[ "$clean" == "$ZS_NEW_SESSION_LABEL_CLEAN" ]] && { printf '%s' "$ZS_NEW_SESSION_LABEL"; return 0; }
    printf '%s' "${clean%% *}"
}

_purge_session_info() {
    local s="${1:-}"
    case "$s" in
        ""|.*|*/*|*..*) return 0 ;;
    esac
    rm -rf -- "${XDG_CACHE_HOME:-$HOME/.cache}/zellij/contract_version_1/session_info/$s"
}

_mark_exited() {
    local s="${1:-}"
    case "$s" in
        ""|.*|*/*|*..*) return 0 ;;
    esac
    mkdir -p "$ZS_STATE_DIR"
    { grep -Fxv -- "$s" "$ZS_EXITED_FILE" 2>/dev/null || true; printf '%s\n' "$s"; } \
        > "$ZS_EXITED_FILE.tmp"
    mv "$ZS_EXITED_FILE.tmp" "$ZS_EXITED_FILE"
}

_unmark_exited() {
    local s="${1:-}"
    [[ -f "$ZS_EXITED_FILE" ]] || return 0
    grep -Fxv -- "$s" "$ZS_EXITED_FILE" > "$ZS_EXITED_FILE.tmp" 2>/dev/null || true
    mv "$ZS_EXITED_FILE.tmp" "$ZS_EXITED_FILE"
}

_kill_stale_server() {
    local s="${1:-}" pid cmd
    case "$s" in
        ""|.*|*/*|*..*) return 0 ;;
    esac
    while read -r pid; do
        [[ -z "$pid" ]] && continue
        cmd=$(ps -p "$pid" -o args= 2>/dev/null || true)
        case "$cmd" in
            *"zellij --server "*/contract_version_1/"$s")
                kill "$pid" 2>/dev/null || true
                ;;
        esac
    done < <(pgrep -f "zellij --server .*/contract_version_1/$s$" 2>/dev/null || true)
}

_delete_session_completely() {
    local s="${1:-}"
    zellij delete-session --force "$s" >/dev/null 2>&1 || true
    _kill_stale_server "$s"
    sleep 0.1
    _purge_session_info "$s"
}

_current_session() {
    zellij ls 2>/dev/null \
        | sed 's/\x1b\[[0-9;]*m//g' \
        | awk '/\(current\)/{print $1; exit}'
}

_clean_zellij_ls() {
    zellij ls 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'
}

_session_is_active() {
    local s="${1:-}"
    [[ -n "$s" ]] || return 1
    _clean_zellij_ls | awk -v name="$s" '$1 == name && $0 !~ /EXITED/ { found=1 } END { exit found ? 0 : 1 }'
}

_session_name_exists() {
    local s="${1:-}"
    [[ -n "$s" ]] || return 1
    if _clean_zellij_ls | awk -v name="$s" '$1 == name { found=1 } END { exit found ? 0 : 1 }'; then
        return 0
    fi
    [[ -f "$ZS_EXITED_FILE" ]] && grep -Fxq -- "$s" "$ZS_EXITED_FILE"
}

_focus_session_window() {
    local s="${1:-}" win_id
    [[ -n "$s" ]] || return 1
    command -v wmctrl >/dev/null 2>&1 || return 1

    win_id=$(
        wmctrl -lx 2>/dev/null | awk -v name="$s" '
            $3 ~ /ghostty/ {
                title = ""
                for (i = 5; i <= NF; i++) {
                    title = title (i == 5 ? "" : " ") $i
                }
                if (title == "zs-" name || title == "zs:" name || title == name || index(title, name " |") == 1) {
                    print $1
                    exit
                }
            }
        '
    )
    [[ -n "$win_id" ]] || return 1
    wmctrl -ia "$win_id" >/dev/null 2>&1
}

_valid_session_name() {
    local s="${1:-}"
    [[ -n "$s" && "$s" != .* && "$s" != */* && "$s" != *" "* && "$s" != *".."* ]]
}

_next_session_name() {
    local names=(alpha beta gamma delta epsilon zeta eta theta iota kappa lambda mu nu xi omicron pi rho sigma tau upsilon phi chi psi omega)
    local name n
    for name in "${names[@]}"; do
        if ! _session_name_exists "$name"; then
            printf '%s\n' "$name"
            return 0
        fi
    done
    n=2
    while :; do
        for name in "${names[@]}"; do
            if ! _session_name_exists "$name-$n"; then
                printf '%s\n' "$name-$n"
                return 0
            fi
        done
        ((n++))
    done
}

_open_session() {
    local s="${1:-}"
    [[ -n "$s" ]] || exit 0
    _unmark_exited "$s"
    "${ZS_GHOSTTY_ENV[@]}" setsid ghostty --title="zs-$s" -e zellij attach --create --force-run-commands "$s" 2>/dev/null &
    local i=0
    while (( i++ < 20 )); do
        _clean_zellij_ls | awk -v name="$s" '$1 == name { found=1 } END { exit found ? 0 : 1 }' && return 0
        sleep 0.15
    done
}

_set_notice() {
    local msg="${1:-}" ttl="${2:-3}" now
    [[ -n "$msg" ]] || return 0
    mkdir -p "$ZS_STATE_DIR"
    now=$(date +%s)
    {
        printf '%s\n' "$((now + ttl))"
        printf '%s\n' "$msg"
    } > "$ZS_NOTICE_FILE"
}

_show_notice_if_any() {
    [[ -f "$ZS_NOTICE_FILE" ]] || return 1
    local expires now remaining
    IFS= read -r expires < "$ZS_NOTICE_FILE" || return 1
    now=$(date +%s)
    if [[ -z "$expires" || "$now" -ge "$expires" ]]; then
        rm -f "$ZS_NOTICE_FILE"
        return 1
    fi

    remaining=$((expires - now))
    printf '\033[2J\033[H'
    printf '\n\n\n\n'
    printf '        +----------------------------------+\n'
    printf '        |          cannot delete          |\n'
    printf '        |                                  |\n'
    printf '        |  d only deletes exited sessions  |\n'
    printf '        |  press k first                   |\n'
    printf '        +----------------------------------+\n'
    sleep "$remaining"
    printf '\033[2J\033[H'
    rm -f "$ZS_NOTICE_FILE"
    return 0
}

# ── Launch ─────────────────────────────────────────────────────────────────────
if [[ -z "${ZS_INNER:-}" && $# -eq 0 ]]; then
    ZS_CURRENT=$(zellij ls 2>/dev/null \
        | sed 's/\x1b\[[0-9;]*m//g' \
        | awk '/\(current\)/{print $1}' || true)

    _delete_session_completely _zs

    _layout=$(mktemp /tmp/zs_layout_XXXXX.kdl)
    trap 'rm -f "$_layout"' EXIT
    _cmd="ZS_INNER=1 ZS_CURRENT=$(printf '%q' "$ZS_CURRENT") $(printf '%q' "$SCRIPT")"
    cat > "$_layout" <<LAYOUT
layout {
    tab name="zs" {
        pane command="bash" close_on_exit=true {
            args "-lc" "$_cmd"
            start_suspended false
        }
    }
}
LAYOUT
    "${ZS_GHOSTTY_ENV[@]}" ghostty --gtk-single-instance=false \
        --window-width=120 --window-height=25 \
        -e zellij --session _zs --new-session-with-layout "$_layout" \
        2>/dev/null
    rm -f "$_layout"
    exit 0
fi

# ── Preview ────────────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--preview" ]]; then
    session="${2:-}"
    [[ -z "$session" ]] && exit 0
    _show_notice_if_any || true
    session_clean=$(printf '%s' "$session" | sed 's/\x1b\[[0-9;]*m//g')
    if [[ "$session_clean" == "$ZS_NEW_SESSION_LABEL_CLEAN" ]]; then
        printf '\n\n\n\n'
        printf '        +----------------------------------+\n'
        printf '        | \033[1;3;34m★ ★ ★ Create a new session ★ ★ ★\033[0m |\n'
        printf '        |                                  |\n'
        printf '        |      \033[34m\033[1ma\033[0m open with an auto name    |\n'
        printf '        |     \033[34m\033[1mr\033[0m name it first, then open   |\n'
        printf '        +----------------------------------+\n'
        exit 0
    fi
    zellij --session "$session" action dump-layout 2>/dev/null \
    | python3 -c "
import sys, re
lines = sys.stdin.read().split('\n')
results = []
current_tab = None
depth = 0
skip_depth = None
for i, line in enumerate(lines):
    stripped = line.strip()
    opens = stripped.count('{')
    closes = stripped.count('}')
    if skip_depth is not None:
        depth += opens - closes
        if depth <= skip_depth: skip_depth = None
        continue
    if re.match(r'(new_tab_template|swap_\w+_layout)\b', stripped):
        skip_depth = depth; depth += opens - closes; continue
    if re.search(r'\bplugin\b', stripped) and 'location=' in stripped:
        skip_depth = depth - 1; depth += opens - closes; continue
    if re.search(r'^\s*tab\b', line) and 'name=' in line and 'max_panes' not in line:
        m = re.search(r'name=\"([^\"]+)\"', line)
        if m:
            if current_tab is not None: results.append(current_tab)
            current_tab = [m.group(1), []]
    elif re.search(r'\bpane\b', stripped) and 'command=' in stripped and 'split_direction' not in stripped:
        if current_tab is not None:
            m = re.search(r'command=\"([^\"]+)\"', stripped)
            if m:
                cmd = m.group(1)
                name_m = re.search(r'name=\"([^\"]+)\"', stripped)
                args = []
                for j in range(i+1, min(i+5, len(lines))):
                    ns = lines[j].strip()
                    if ns.startswith('args '):
                        args = re.findall(r'\"([^\"]+)\"', ns[5:]); break
                    elif ns and not re.match(r'^[{}]', ns) and not re.match(r'^(start_suspended|focus|size|cwd|borderless|name)\b', ns): break
                full = (cmd + ' ' + ' '.join(args)) if args else (name_m.group(1) if name_m else cmd)
                if len(full) > 65: full = full[:62] + '...'
                current_tab[1].append(full)
    elif re.search(r'\bpane\b', stripped) and 'name=' in stripped and 'command=' not in stripped and 'split_direction' not in stripped:
        if current_tab is not None:
            m = re.search(r'name=\"([^\"]+)\"', stripped)
            if m: current_tab[1].append(m.group(1))
    elif re.search(r'\bpane\b', stripped) and 'command=' not in stripped and 'name=' not in stripped and 'split_direction' not in stripped:
        if current_tab is not None and '{' not in stripped: current_tab[1].append('shell')
    depth += opens - closes
if current_tab is not None: results.append(current_tab)
if not results:
    print('(no info)')
else:
    for tab_name, panes in results:
        print(f'	     \033[1;3;91m● ● ● List of content ● ● ●\033[0m	')
        for p in panes: print(f'\033[1;3;91m●\033[0m  \033[1;96m{p}\033[0m')
        if not panes: print('  shell')
        print()
" 2>/dev/null || echo "(preview unavailable)"
    exit 0
fi

# ── Session list ───────────────────────────────────────────────────────────────
if [[ "${1:-}" == "--list-sessions" ]]; then
    _ls_cache=$(_clean_zellij_ls)

    printf '%s\n' "$_ls_cache" | awk '
            /^_zs[[:space:]]/ || $1 == "_zs" { next }
            /EXITED/ { printf "\033[31m%s\033[0m  (exited)\n", $1; next }
            NF { print $1 }
        '
    if [[ -f "$ZS_EXITED_FILE" ]]; then
        active_names=$(printf '%s\n' "$_ls_cache" | awk 'NF { print $1 }' | sort -u)
        while IFS= read -r s; do
            [[ -z "$s" || "$s" == "_zs" ]] && continue
            if ! grep -Fxq -- "$s" <<< "$active_names"; then
                printf '\033[31m%s\033[0m  (exited)\n' "$s"
            fi
        done < "$ZS_EXITED_FILE"
    fi
    printf '%s\n' "$ZS_NEW_SESSION_LABEL"
    exit 0
fi

# ── Actions ────────────────────────────────────────────────────────────────────
if [[ "${1:-}" =~ ^--(kill|delete|force)$ ]]; then
    mode="${1#--}"; shift
    header_after_delete="$HEADER"
    for raw in "$@"; do
        s=$(_name "$raw")
        [[ -z "$s" || "$s" == "$ZS_NEW_SESSION_LABEL" ]] && continue
        case "$mode" in
            kill)   zellij kill-session "$s" 2>/dev/null
                    _mark_exited "$s" ;;
            delete) if _session_is_active "$s"; then
                        header_after_delete="$DELETE_HINT"
                        _set_notice "$DELETE_HINT" 3
                        continue
                    fi
                    if zellij delete-session "$s" 2>/dev/null; then
                        _unmark_exited "$s"
                        _purge_session_info "$s"
                    elif [[ -f "$ZS_EXITED_FILE" ]] && grep -Fxq -- "$s" "$ZS_EXITED_FILE"; then
                        _unmark_exited "$s"
                        _purge_session_info "$s"
                    fi ;;
            force)  _delete_session_completely "$s"
                    _unmark_exited "$s" ;;
        esac
    done
    [[ "$mode" == "delete" ]] && printf '%s\n' "$header_after_delete"
    exit 0
fi

if [[ "${1:-}" == "--attach" ]]; then
    s=$(_name "${2:-}")
    [[ -z "$s" ]] && exit 0
    if [[ "$s" == "$ZS_NEW_SESSION_LABEL" ]]; then
        s=$(_next_session_name)
    fi
    if _focus_session_window "$s"; then
        printf '%s\n' "$HEADER"
        exit 0
    fi
    _open_session "$s"
    printf '%s\n' "$HEADER"
    exit 0
fi

if [[ "${1:-}" == "--rename" ]]; then
    s=$(_name "${2:-}")
    [[ -z "$s" ]] && exit 0
    if [[ "$s" == "$ZS_NEW_SESSION_LABEL" ]]; then
        newname=$(
            printf '\n' | fzf --print-query --query "$(_next_session_name)" \
                --height=40% \
                --prompt="new session > " \
                --header="enter: create  esc: cancel" \
                --no-info \
                --disabled \
                | sed -n '1p'
        )
        [[ -z "$newname" ]] && exit 0
        if ! _valid_session_name "$newname"; then
            printf 'Invalid session name. Use a simple name without spaces or slashes.\n'
            printf 'press enter to continue... '
            read -r _
            exit 0
        fi
        if _session_name_exists "$newname"; then
            printf '%s already exists.\n' "$newname"
            printf 'press enter to continue... '
            read -r _
            exit 0
        fi
        _open_session "$newname"
        exit 0
    fi
    read -e -i "$s" -p "rename > " newname
    [[ -z "$newname" || "$newname" == "$s" ]] && exit 0
    if ! _valid_session_name "$newname"; then
        printf 'Invalid session name. Use a simple name without spaces or slashes.\n'
        printf 'press enter to continue... '
        read -r _
        exit 0
    fi
    if _session_name_exists "$newname"; then
        printf '%s already exists.\n' "$newname"
        printf 'press enter to continue... '
        read -r _
        exit 0
    fi
    zellij --session "$s" action rename-session "$newname" 2>/dev/null
    exit 0
fi

# ── Main ───────────────────────────────────────────────────────────────────────
trap 'stty sane 2>/dev/null; tput cnorm 2>/dev/null; exit 0' INT TERM

sessions=$("$SCRIPT" --list-sessions)

if [[ -z "$sessions" ]]; then
    echo "No zellij sessions found."
    exit 0
fi

clear
printf '%s\n' "$sessions" | fzf --multi \
    --ansi \
    --disabled \
    --height=100% \
    --layout=reverse \
    --border \
    --prompt="zellij > " \
    --header="$HEADER" \
    --preview="timeout 4 \"$SCRIPT\" --preview {} 2>/dev/null || echo '(preview timeout)'" \
    --preview-window="right:50%:wrap" \
    --bind="ctrl-c:abort" \
    --bind="return:toggle" \
    --bind="ctrl-a:select-all" \
    --bind="esc:disable-search+clear-query+rebind(a,k,d,f,r)" \
    --bind="/:enable-search+unbind(a,k,d,f,r)" \
    --bind="k:execute-silent(\"$SCRIPT\" --kill {+})+reload(\"$SCRIPT\" --list-sessions)+deselect-all" \
    --bind="a:execute-silent(\"$SCRIPT\" --attach {})+reload(\"$SCRIPT\" --list-sessions)" \
    --bind="d:execute-silent(\"$SCRIPT\" --delete {})+reload(\"$SCRIPT\" --list-sessions)+refresh-preview+deselect-all" \
    --bind="f:execute-silent(\"$SCRIPT\" --force {+})+reload(\"$SCRIPT\" --list-sessions)+deselect-all" \
    --bind="r:execute(\"$SCRIPT\" --rename {})+reload(\"$SCRIPT\" --list-sessions)" \
    > /dev/null

stty sane 2>/dev/null
tput cnorm 2>/dev/null
zellij kill-session _zs &>/dev/null
